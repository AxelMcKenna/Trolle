# ── Supabase Database ──
# Use the DIRECT connection (port 5432), not the pooler (port 6543).
# asyncpg uses prepared statements which require session mode, not transaction mode.
# Supabase dashboard → Settings → Database → Connection string → URI (direct)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres

# ── Redis (local on OCI) ──
REDIS_PASSWORD=generate-a-strong-password-here

# ── API Auth ──
# Generate with: openssl rand -base64 32
SECRET_KEY=
ADMIN_USERNAME=admin
# Must be 12+ chars in production
ADMIN_PASSWORD=

# ── CORS ──
# Comma-separated list of allowed origins (your Vercel domains)
CORS_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com

# ── Supabase Auth (for JWT verification) ──
SUPABASE_URL=https://your-project.supabase.co

# ── Optional ──
API_PORT=8000
LOG_LEVEL=INFO
UVICORN_WORKERS=4
SENTRY_DSN=
ALERT_WEBHOOK_URL=
